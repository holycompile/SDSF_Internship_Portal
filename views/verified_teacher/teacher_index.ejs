    <!-- Embedded Server Data for Client-Side Lookups (Prevents HTML Attribute Truncation of Large PDF Data URLs) -->
    <script id="serverTeacherRequestedData" type="application/json">
        <%- JSON.stringify(typeof requestedStudents !== 'undefined' ? requestedStudents : []) %>
    </script>
    <script id="serverTeacherApprovedData" type="application/json">
        <%- JSON.stringify(typeof approvedStudents !== 'undefined' ? approvedStudents : []) %>
    </script>

    <!-- Client Script for Tabs, Modal Preview, Approval, and Printing -->
    <script>
        const requestedStudentsData = JSON.parse(document.getElementById('serverTeacherRequestedData').textContent || '[]');
        const approvedStudentsData = JSON.parse(document.getElementById('serverTeacherApprovedData').textContent || '[]');

        function getStudentByEnrollment(enrollmentNo) {
            const clean = (enrollmentNo || '').toLowerCase();
            return requestedStudentsData.find(s => (s.enrollmentNo || '').toLowerCase() === clean)
                || approvedStudentsData.find(s => (s.enrollmentNo || '').toLowerCase() === clean);
        }

        function viewOfferDocByEnrollment(enrollmentNo) {
            const st = getStudentByEnrollment(enrollmentNo);
            if (st) {
                viewOfferDocument(st);
            }
        }

        function previewNocByEnrollment(enrollmentNo) {
            const st = getStudentByEnrollment(enrollmentNo);
            if (st) {
                previewNocCertificate(st);
            }
        }

        let currentTabId = 'tabVerified';

        function switchTab(tabId) {
            currentTabId = tabId;
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

            const targetPane = document.getElementById(tabId);
            if (targetPane) targetPane.classList.remove('hidden');

            if (tabId === 'tabVerified') document.getElementById('btnTabVerified').classList.add('active');
            if (tabId === 'tabRequested') document.getElementById('btnTabRequested').classList.add('active');
            if (tabId === 'tabApproved') document.getElementById('btnTabApproved').classList.add('active');

            filterCurrentTable();
        }

        function filterCurrentTable() {
            const query = (document.getElementById('filterSearch').value || '').toLowerCase().trim();
            const rawCourse = (document.getElementById('filterCourse').value || 'all').toLowerCase();
            const courseKey = rawCourse.replace(/[\s_&.-]/g, '');
            
            const activePane = document.getElementById(currentTabId);
            if (!activePane) return;

            const rows = activePane.querySelectorAll('.data-row');
            rows.forEach(row => {
                const name = (row.getAttribute('data-name') || '').toLowerCase();
                const enrollment = (row.getAttribute('data-enrollment') || '').toLowerCase();
                const rowCourseRaw = (row.getAttribute('data-course') || '').toLowerCase();
                const rowCourseKey = rowCourseRaw.replace(/[\s_&.-]/g, '');

                const matchQuery = !query || name.includes(query) || enrollment.includes(query);
                const matchCourse = (rawCourse === 'all') || rowCourseKey.includes(courseKey) || courseKey.includes(rowCourseKey);

                if (matchQuery && matchCourse) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                    const cb = row.querySelector('.requested-checkbox');
                    if (cb) cb.checked = false;
                }
            });

            updateBulkApproveBtn();
        }

        function toggleSelectAllRequested(masterCb) {
            const activePane = document.getElementById('tabRequested');
            if (!activePane) return;
            const rows = activePane.querySelectorAll('.data-row');
            rows.forEach(row => {
                if (row.style.display !== 'none') {
                    const cb = row.querySelector('.requested-checkbox');
                    if (cb) cb.checked = masterCb.checked;
                }
            });
            updateBulkApproveBtn();
        }

        function updateBulkApproveBtn() {
            const btn = document.getElementById('btnBulkApprove');
            const masterCb = document.getElementById('selectAllRequested');
            const activePane = document.getElementById('tabRequested');
            if (!btn || !activePane) return;

            if (currentTabId !== 'tabRequested') {
                btn.classList.add('hidden');
                btn.classList.remove('inline-flex');
                return;
            }

            const visibleCheckboxes = Array.from(activePane.querySelectorAll('.data-row'))
                .filter(row => row.style.display !== 'none')
                .map(row => row.querySelector('.requested-checkbox'))
                .filter(Boolean);

            const checked = visibleCheckboxes.filter(cb => cb.checked);
            const countEl = document.getElementById('bulkCount');
            if (countEl) countEl.innerText = checked.length;

            if (checked.length > 0) {
                btn.classList.remove('hidden');
                btn.classList.add('inline-flex');
            } else {
                btn.classList.add('hidden');
                btn.classList.remove('inline-flex');
            }

            if (masterCb) {
                masterCb.checked = visibleCheckboxes.length > 0 && checked.length === visibleCheckboxes.length;
            }
        }

        async function bulkApproveSelected() {
            const activePane = document.getElementById('tabRequested');
            if (!activePane) return;

            const checkedBoxes = Array.from(activePane.querySelectorAll('.requested-checkbox:checked'));
            const enrollmentNos = checkedBoxes.map(cb => cb.value.trim()).filter(Boolean);

            if (enrollmentNos.length === 0) {
                alert('Please select at least one student NOC request to approve.');
                return;
            }

            if (!confirm(`Are you sure you want to BULK APPROVE ${enrollmentNos.length} selected student NOC request(s)?`)) {
                return;
            }

            try {
                const response = await fetch('/api/teacher/bulk-approve-students', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentNos })
                });

                const data = await response.json();
                if (data.success) {
                    alert(`✓ Successfully approved ${data.count || enrollmentNos.length} students in bulk!`);
                    window.location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Could not complete bulk approval.'));
                }
            } catch (err) {
                console.error('Bulk approval error:', err);
                alert('An error occurred while executing bulk approval.');
            }
        }

        // Open a specific document in a full-screen new tab using the backend streaming endpoint
        function openDocInNewTab(enrollmentNo, docIndex) {
            const cleanEnrollment = encodeURIComponent((enrollmentNo || '').trim());
            const idx = parseInt(docIndex, 10) || 0;
            const url = `/api/view-document?enrollment=${cleanEnrollment}&docIndex=${idx}`;
            window.open(url, '_blank');
        }

        // View Uploaded Document: Direct New Tab if 1 doc, or Selector Modal if multiple docs
        function viewOfferDocument(student) {
            const enrollmentNo = student.enrollmentNo || '';
            let rawDocs = [];
            if (Array.isArray(student.documents) && student.documents.length > 0) {
                rawDocs = student.documents;
            } else if (student.fileDataUrl) {
                rawDocs = [{
                    docName: student.docName || 'Offer_Document.pdf',
                    label: 'Offer Document',
                    fileDataUrl: student.fileDataUrl
                }];
            } else {
                rawDocs = [{
                    docName: 'SDSF_Permission_Letter_Format.pdf',
                    label: 'Department Standard PDF',
                    fileDataUrl: '/docs/SDSF_Internship_Permission_Letter.pdf'
                }];
            }

            // If only 1 document is uploaded, open directly in a new tab!
            if (rawDocs.length <= 1) {
                openDocInNewTab(enrollmentNo, 0);
                return;
            }

            // If multiple documents are attached, show the clean multi-doc selector modal
            document.getElementById('multiDocStudentName').innerText = student.studentName || 'Student';
            document.getElementById('multiDocEnrollment').innerText = student.enrollmentNo || '';

            const listContainer = document.getElementById('multiDocList');
            listContainer.innerHTML = '';

            rawDocs.forEach((doc, idx) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between p-3 bg-slate-50 hover:bg-blue-50/60 border border-slate-200 rounded-lg transition';
                row.innerHTML = `
                    <div class="flex items-center gap-2.5 truncate mr-3">
                        <i class="fas fa-file-pdf text-red-500 text-lg shrink-0"></i>
                        <div class="truncate text-left">
                            <span class="block text-xs font-bold text-slate-800 truncate">${doc.label || ('Document ' + (idx + 1))}</span>
                            <span class="block text-[11px] text-slate-500 truncate">${doc.docName || 'Attachment.pdf'}</span>
                        </div>
                    </div>
                    <button type="button" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-3 py-1.5 rounded-md shadow-xs transition shrink-0 flex items-center gap-1.5 cursor-pointer">
                        <i class="fas fa-external-link-alt text-[10px]"></i> Open in New Tab
                    </button>
                `;
                row.querySelector('button').onclick = () => openDocInNewTab(enrollmentNo, idx);
                listContainer.appendChild(row);
            });

            document.getElementById('btnOpenAllDocs').onclick = () => {
                rawDocs.forEach((doc, idx) => openDocInNewTab(enrollmentNo, idx));
            };

            document.getElementById('multiDocModal').classList.add('active');
        }

        // Preview NOC Letter Certificate Modal
        function previewNocCertificate(student) {
            const studentName = student.studentName || 'Student Name';
            const enrollmentNo = student.enrollmentNo || '—';
            const course = student.course || 'School of Data Science';
            const semester = student.semester || 'Sem I';
            const companyName = student.companyName || 'Host Organization';
            const mode = student.internshipMode || 'Off-Campus';
            const refNum = Math.floor(100 + Math.random() * 900);
            const dateStr = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

            document.getElementById('nocStudentName').innerText = studentName;
            document.getElementById('nocSigStudentName').innerText = studentName;
            document.getElementById('nocEnrollmentNo').innerText = enrollmentNo;
            document.getElementById('nocCourseName').innerText = course;
            document.getElementById('nocSemesterName').innerText = semester;
            document.getElementById('nocCompanyName').innerText = companyName;
            document.getElementById('nocModeName').innerText = mode;
            document.getElementById('nocRefNum').innerText = refNum;
            document.getElementById('nocCurrentDate').innerText = dateStr;

            const dynamicBtn = document.getElementById('nocOpenDynamicBtn');
            if (dynamicBtn) {
                dynamicBtn.href = `/docs_dynamic/dynamic_noc_letter.html?studentName=${encodeURIComponent(studentName)}&enrollmentNo=${encodeURIComponent(enrollmentNo)}&course=${encodeURIComponent(course)}&semester=${encodeURIComponent(semester)}&companyName=${encodeURIComponent(companyName)}&mode=${encodeURIComponent(mode)}&ref=${refNum}&date=${encodeURIComponent(dateStr)}`;
            }

            const permBtn = document.getElementById('permOpenDynamicBtn');
            if (permBtn) {
                permBtn.href = `/docs_dynamic/dynamic_permission_letter.html?studentName=${encodeURIComponent(studentName)}&enrollmentNo=${encodeURIComponent(enrollmentNo)}&course=${encodeURIComponent(course)}&semester=${encodeURIComponent(semester)}&companyName=${encodeURIComponent(companyName)}&mode=${encodeURIComponent(mode)}&ref=${refNum}&date=${encodeURIComponent(dateStr)}`;
            }

            document.getElementById('nocPreviewModal').classList.add('active');
        }

        function closeModal(modalId) {
            const el = document.getElementById(modalId);
            if (el) el.classList.remove('active');
        }

        function closeModalOnOverlay(event, modalId) {
            if (event.target.id === modalId) {
                closeModal(modalId);
            }
        }

        // Print Current Active Table Records
        function triggerPrint() {
            const titles = {
                'tabVerified': 'Verified Students List',
                'tabRequested': 'Pending NOC Applications List',
                'tabApproved': 'Approved Students List'
            };
            document.getElementById('printReportTitle').innerText = `${titles[currentTabId]} — Generated on ${new Date().toLocaleString()}`;
            window.print();
        }

        // Print NOC Certificate Only
        function printNocCertificateOnly() {
            const printContent = document.getElementById('nocCertificatePrintArea').innerHTML;
            const printWindow = window.open('', '', 'width=800,height=900');
            printWindow.document.write(`
                <html>
                <head>
                    <title>SDSF NOC Certificate</title>
                    <style>
                        body { font-family: 'Times New Roman', serif; padding: 40px; color: #000; line-height: 1.6; }
                        h2, h3 { margin: 2px 0; text-align: center; }
                        .text-center { text-align: center; }
                        .border-b { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
                        .flex-between { display: flex; justify-content: space-between; margin-bottom: 20px; }
                        .mt-12 { margin-top: 50px; }
                    </style>
                </head>
                <body>
                    ${printContent}
                </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => {
                printWindow.print();
                printWindow.close();
            }, 500);
        }

        async function approveStudentNOC(enrollmentNo) {
            if (!confirm(`Are you sure you want to APPROVE the NOC request for student [${enrollmentNo}]?`)) {
                return;
            }

            try {
                const response = await fetch('/api/teacher/approve-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentNo })
                });

                const data = await response.json();
                if (data.success) {
                    alert(`✓ Successfully approved student [${enrollmentNo}]! Record moved to Approved Students.`);
                    window.location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Could not approve student.'));
                }
            } catch (err) {
                console.error('Approval error:', err);
                alert('An error occurred while approving the NOC request.');
            }
        }

        async function revokeStudentApproval(enrollmentNo) {
            if (!confirm(`Are you sure you want to REVERT / DISAPPROVE approval for student [${enrollmentNo}]? The student will be moved back to Requested NOCs.`)) {
                return;
            }

            try {
                const response = await fetch('/api/teacher/revoke-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentNo })
                });

                const data = await response.json();
                if (data.success) {
                    alert(`✓ Approval revoked for student [${enrollmentNo}]. Record moved back to Requested NOCs.`);
                    window.location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Could not revoke approval.'));
                }
            } catch (err) {
                console.error('Revoke error:', err);
                alert('An error occurred while revoking student approval.');
            }
        }

        function exportCurrentTableToCSV() {
            const activePane = document.getElementById(currentTabId);
            if (!activePane) return;

            const table = activePane.querySelector('table');
            let csv = [];
            for (let row of table.rows) {
                if (row.style.display === 'none') continue;
                let rowData = [];
                for (let cell of row.cells) {
                    let text = cell.innerText.replace(/"/g, '""').trim();
                    rowData.push(`"${text}"`);
                }
                csv.push(rowData.join(','));
            }

            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `SDSF_${currentTabId}_${new Date().toISOString().slice(0,10)}.csv`;
            link.click();
        }
    </script>
