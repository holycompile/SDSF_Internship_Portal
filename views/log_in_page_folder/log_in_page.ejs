    <!-- Interactive Scripts -->
    <script>
        function switchTab(role) {
            const studentTab = document.getElementById('tab-student');
            const teacherTab = document.getElementById('tab-teacher');
            const helpTab = document.getElementById('tab-help');
            const studentForm = document.getElementById('form-student');
            const teacherForm = document.getElementById('form-teacher');
            const helpSection = document.getElementById('section-help');

            const inactiveClass = 'flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 text-slate-500 hover:text-slate-800 cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]';

            if (role === 'student') {
                studentTab.className = 'flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 bg-white text-blue-600 shadow-sm cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]';
                teacherTab.className = inactiveClass;
                helpTab.className = inactiveClass;
                studentForm.classList.remove('hidden');
                teacherForm.classList.add('hidden');
                helpSection.classList.add('hidden');
            } else if (role === 'teacher') {
                teacherTab.className = 'flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 bg-white text-teal-600 shadow-sm cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]';
                studentTab.className = inactiveClass;
                helpTab.className = inactiveClass;
                teacherForm.classList.remove('hidden');
                studentForm.classList.add('hidden');
                helpSection.classList.add('hidden');
            } else if (role === 'help') {
                helpTab.className = 'flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 bg-white text-indigo-600 shadow-sm cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]';
                studentTab.className = inactiveClass;
                teacherTab.className = inactiveClass;
                helpSection.classList.remove('hidden');
                studentForm.classList.add('hidden');
                teacherForm.classList.add('hidden');
            }
        }

        function togglePass(inputId, el) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                el.classList.remove('fa-eye');
                el.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                el.classList.remove('fa-eye-slash');
                el.classList.add('fa-eye');
            }
        }

        // ================= Password Reset Modal Logic =================
        function showResetAlert(type, message) {
            const alertBox = document.getElementById('resetModalAlert');
            alertBox.className = type === 'error' 
                ? 'mb-4 p-3 rounded-lg text-xs flex items-start gap-2 bg-red-50 border border-red-200 text-red-700' 
                : 'mb-4 p-3 rounded-lg text-xs flex items-start gap-2 bg-emerald-50 border border-emerald-200 text-emerald-800';
            
            const icon = type === 'error' ? 'fa-exclamation-circle text-red-500' : 'fa-check-circle text-emerald-600';
            alertBox.innerHTML = `<i class="fas ${icon} text-sm mt-0.5 shrink-0"></i><div>${message}</div>`;
            alertBox.classList.remove('hidden');
        }

        function clearResetAlert() {
            const alertBox = document.getElementById('resetModalAlert');
            alertBox.classList.add('hidden');
            alertBox.innerHTML = '';
        }

        function openResetPasswordModal() {
            const currentEnrollment = document.getElementById('student-enrollment') ? document.getElementById('student-enrollment').value.trim() : '';
            const modal = document.getElementById('modalResetPassword');
            const enrollmentInput = document.getElementById('resetEnrollmentInput');
            
            if (currentEnrollment) {
                enrollmentInput.value = currentEnrollment;
            }
            
            backToStep1();
            clearResetAlert();
            modal.classList.remove('hidden');
            enrollmentInput.focus();
        }

        function closeResetPasswordModal() {
            document.getElementById('modalResetPassword').classList.add('hidden');
            clearResetAlert();
        }

        function backToStep1() {
            document.getElementById('resetStep1').classList.remove('hidden');
            document.getElementById('resetStep2').classList.add('hidden');
            clearResetAlert();
        }

        async function handleSendOtp() {
            const enrollment = document.getElementById('resetEnrollmentInput').value.trim();
            const btn = document.getElementById('btnSendOtp');
            clearResetAlert();

            if (!enrollment) {
                showResetAlert('error', 'Please enter your Enrollment Number.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> <span>Sending Verification Code...</span>';

            try {
                const response = await fetch('/api/student/send-password-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enrollmentNo: enrollment })
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('resetMaskedEmail').textContent = data.maskedEmail || 'registered email';
                    document.getElementById('resetStep1').classList.add('hidden');
                    document.getElementById('resetStep2').classList.remove('hidden');
                    document.getElementById('resetOtpInput').value = '';
                    document.getElementById('resetNewPass').value = '';
                    document.getElementById('resetConfirmPass').value = '';
                    showResetAlert('success', data.message || 'Verification OTP sent to your registered email.');
                    document.getElementById('resetOtpInput').focus();
                } else {
                    showResetAlert('error', data.message || 'Failed to send verification OTP.');
                }
            } catch (err) {
                console.error('Error sending OTP:', err);
                showResetAlert('error', 'Network or server error occurred while sending OTP.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane text-xs"></i> <span>Send Verification Code</span>';
            }
        }

        async function handleSubmitReset() {
            const enrollment = document.getElementById('resetEnrollmentInput').value.trim();
            const otp = document.getElementById('resetOtpInput').value.trim();
            const newPassword = document.getElementById('resetNewPass').value;
            const confirmPassword = document.getElementById('resetConfirmPass').value;
            const btn = document.getElementById('btnSubmitReset');
            clearResetAlert();

            if (!otp || otp.length !== 6) {
                showResetAlert('error', 'Please enter a valid 6-digit verification OTP code.');
                return;
            }
            if (!newPassword || newPassword.length < 6) {
                showResetAlert('error', 'New password must be at least 6 characters long.');
                return;
            }
            if (newPassword !== confirmPassword) {
                showResetAlert('error', 'Passwords do not match. Please re-enter.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> <span>Updating Password...</span>';

            try {
                const response = await fetch('/api/student/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        enrollmentNo: enrollment,
                        otp: otp,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showResetAlert('success', data.message || 'Password updated successfully!');
                    
                    // Autofill login inputs with new credentials
                    if (document.getElementById('student-enrollment')) {
                        document.getElementById('student-enrollment').value = enrollment;
                    }
                    if (document.getElementById('student-pass')) {
                        document.getElementById('student-pass').value = newPassword;
                    }

                    setTimeout(() => {
                        closeResetPasswordModal();
                        alert('Your password has been changed and securely saved! You can now click "Log In".');
                    }, 1200);
                } else {
                    showResetAlert('error', data.message || 'Failed to update password.');
                }
            } catch (err) {
                console.error('Error resetting password:', err);
                showResetAlert('error', 'Network or server error occurred while updating password.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> <span>Update Password</span>';
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const backToTopBtn = document.getElementById("sdsfBackToTop");
            if (backToTopBtn) {
                backToTopBtn.addEventListener("click", function(e) {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
            }
        });
    </script>
