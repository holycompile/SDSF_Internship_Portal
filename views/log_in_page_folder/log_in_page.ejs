                </ul>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <div class="footer-bottom-container">
                <p class="copyright-text">&copy; SDSF - School of Data Science and Forecasting, DAVV Indore. All Rights Reserved. Developed by Joyobrata Das -- M.Tech AI&DS , Student Developer</p>
                <a href="#top" id="sdsfBackToTop" class="sdsf-back-to-top" aria-label="Back to top" title="Back to Top">
                    <i class="fas fa-chevron-up"></i>
                </a>
            </div>
        </div>
    </footer>

    <!-- Interactive Scripts -->
    <script>
        function switchTab(role) {
            const studentTab = document.getElementById('tab-student');
            const teacherTab = document.getElementById('tab-teacher');
            const studentForm = document.getElementById('form-student');
            const teacherForm = document.getElementById('form-teacher');

            if (role === 'student') {
                studentTab.className = 'flex-1 py-2 px-3.5 text-xs sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-2 bg-white text-blue-600 shadow-sm cursor-pointer';
                teacherTab.className = 'flex-1 py-2 px-3.5 text-xs sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 cursor-pointer';
                studentForm.classList.remove('hidden');
                teacherForm.classList.add('hidden');
            } else {
                teacherTab.className = 'flex-1 py-2 px-3.5 text-xs sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-2 bg-white text-teal-600 shadow-sm cursor-pointer';
                studentTab.className = 'flex-1 py-2 px-3.5 text-xs sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 cursor-pointer';
                teacherForm.classList.remove('hidden');
                studentForm.classList.add('hidden');
            }
        }

        function togglePass(inputId, el) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                el.classList.remove('fa-eye');
                el.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                el.classList.remove('fa-eye-slash');
                el.classList.add('fa-eye');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const backToTopBtn = document.getElementById("sdsfBackToTop");
            if (backToTopBtn) {
                backToTopBtn.addEventListener("click", function(e) {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
            }
        });
    </script>
</body>
</html>
