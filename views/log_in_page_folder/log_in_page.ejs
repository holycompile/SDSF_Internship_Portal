<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internship Portal | SDSF DAVV Indore</title>
    
    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Oswald:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Scoped Website Footer Styles -->
    <link rel="stylesheet" href="/log_in_page_folder/header_footer.css">

    <!-- Tailwind CSS (Fast Synchronous CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        heading: ['Oswald', 'sans-serif'],
                        montserrat: ['Montserrat', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .font-heading { font-family: 'Oswald', sans-serif; }
        .font-montserrat { font-family: 'Montserrat', sans-serif; }
        
        /* Critical Instant Layout (Prevents FOUC / Size Shift on Load) */
        .portal-card {
            width: 100% !important;
            max-width: 720px !important;
        }
        .portal-form-box {
            width: 100% !important;
            max-width: 28rem !important;
        }

        /* Custom Input Styling */
        .portal-input {
            width: 100% !important;
            padding: 11px 14px 11px 44px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            font-size: 14.5px !important;
            line-height: 1.5 !important;
            color: #1e293b !important;
            background-color: #ffffff !important;
            outline: none !important;
            transition: all 0.2s ease !important;
            box-sizing: border-box !important;
        }
        .portal-input:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }
        .portal-teacher-input:focus {
            border-color: #0d9488 !important;
            box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.12) !important;
        }
    </style>
</head>
<body id="top" class="bg-[#f8fafc] text-slate-800 flex flex-col min-h-screen">

    <!-- Top Dark Navy Copyright Bar with Gold Divider (from Image) -->
    <div class="bg-[#121b38] text-slate-200 text-xs py-2 px-4 text-center font-montserrat tracking-wide border-b-4 border-[#f2b300]">
        © SDSF – School of Data Science and Forecasting, DAVV Indore. All Rights Reserved.
    </div>

    <!-- Clean White Institutional Header Strip -->
    <header class="bg-white border-b border-slate-200 shadow-sm py-2.5 sm:py-3 px-3 sm:px-8">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4">
            
            <!-- Left Side: DAVV Logo & Department Names -->
            <div class="flex items-center gap-2.5 sm:gap-4 w-full sm:w-auto justify-start text-left">
                <img src="/photoes/davvLogo.png" alt="DAVV Logo" class="h-11 sm:h-16 w-auto object-contain shrink-0">
                <div class="min-w-0 flex-1 sm:flex-initial">
                    <h1 class="text-xs sm:text-base font-bold text-[#162b57] font-heading tracking-wide uppercase leading-tight">
                        DEVI AHILYA VISHWAVIDYALAYA, INDORE
                    </h1>
                    <h2 class="text-[10px] sm:text-sm font-semibold text-slate-700 font-heading tracking-wide uppercase leading-tight mt-0.5">
                        School of Data Science and Forecasting (SDSF)
                    </h2>
                    <p class="text-[9px] sm:text-[11px] text-slate-500 leading-tight">Takshila Campus, Khandwa Road, Indore - 452001 (M.P.)</p>
                </div>
            </div>

            <!-- Right Side: Department Logo & Back Button -->
            <div class="flex items-center justify-between sm:justify-end gap-2.5 sm:gap-6 w-full sm:w-auto">
                <img src="/photoes/deplogo.png" onerror="this.src='/photoes/departmentlogo_transparent.png'" alt="SDSF Logo" class="h-10 sm:h-14 w-auto object-contain block sm:hidden md:block shrink-0">
                <a href="https://dsf.dauniv.ac.in/" class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-[#162b57] hover:bg-[#0b132b] text-white text-xs font-semibold px-3 sm:px-4 py-2 sm:py-2.5 rounded-md shadow-sm transition flex-1 sm:flex-initial text-center min-h-[38px]">
                    <i class="fas fa-arrow-left text-xs"></i> <span>Back to Main Website</span>
                </a>
            </div>

        </div>
    </header>

    <!-- Main Internship Portal Section -->
    <main class="py-4 sm:py-8 px-2.5 sm:px-4 flex items-center justify-center flex-grow">
        <div class="portal-card w-full max-w-[720px] bg-white rounded-xl shadow-xl border border-slate-200 overflow-hidden flex flex-col">
            
            <!-- Top Dark Navy Card Banner -->
            <div class="bg-[#16223e] text-white py-3.5 px-4 sm:py-4 sm:px-6 text-center border-b-4 border-[#f2b300]">
                <span class="inline-block bg-[#f2b300]/15 border border-[#f2b300]/40 text-[#f2b300] text-[10.5px] sm:text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider mb-1">
                    <i class="fas fa-briefcase mr-1"></i> SDSF WORKSPACE
                </span>
                <h2 class="text-xl sm:text-[28px] font-bold tracking-wider uppercase font-heading text-white leading-tight">INTERNSHIP PORTAL</h2>
                <p class="text-slate-300 text-[11px] sm:text-xs">Welcome to the School of Data Science and Forecasting Internship Gateway</p>
            </div>

            <!-- Card Content Panel -->
            <div class="px-3.5 py-4 sm:px-10 sm:py-6">
                
                <!-- Role Selector Tabs -->
                <div class="flex bg-slate-100 p-1 sm:p-1.5 rounded-lg mb-5 sm:mb-6 max-w-lg mx-auto border border-slate-200 gap-1 sm:gap-1.5 overflow-x-auto no-scrollbar">
                    <button type="button" id="tab-student" onclick="switchTab('student')" class="flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 bg-white text-blue-600 shadow-sm cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]">
                        <i class="fas fa-user-graduate text-xs sm:text-sm shrink-0"></i> <span class="truncate">Student Login</span>
                    </button>
                    <button type="button" id="tab-teacher" onclick="switchTab('teacher')" class="flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 text-slate-500 hover:text-slate-800 cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]">
                        <i class="fas fa-chalkboard-teacher text-xs sm:text-sm shrink-0"></i> <span class="truncate">Teacher Login</span>
                    </button>
                    <button type="button" id="tab-help" onclick="switchTab('help')" class="flex-1 py-2 px-1.5 sm:px-3.5 text-[11px] sm:text-sm font-semibold rounded-md transition flex items-center justify-center gap-1 sm:gap-2 text-slate-500 hover:text-slate-800 cursor-pointer whitespace-nowrap min-w-0 min-h-[38px]">
                        <i class="fas fa-headset text-xs sm:text-sm shrink-0"></i> <span class="truncate">Help Desk</span>
                    </button>
                </div>

                <!-- Student Login Form -->
                <div id="form-student" class="portal-form-box max-w-md mx-auto block">
                    <div class="text-center mb-5 sm:mb-6">
                        <h3 class="text-xl sm:text-2xl font-bold text-slate-800 font-heading">Student Portal Log In</h3>
                        <p class="text-slate-500 text-xs sm:text-sm mt-1">Access your internship applications and submission dashboard</p>
                        <p class="text-blue-600 text-xs sm:text-sm font-semibold mt-1"> Eligible for Final Year students only </p>
                    </div>

                    <!-- Error Alert (If Any) -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="bg-red-50 border border-red-200 border-l-4 border-l-red-500 text-red-700 text-xs p-3.5 rounded-md mb-5 flex items-start gap-2.5">
                            <i class="fas fa-exclamation-circle text-red-500 text-sm mt-0.5 shrink-0"></i>
                            <div>
                                <span class="font-bold">Verification Failed:</span> <%= error %>
                            </div>
                        </div>
                    <% } %>

                    <form action="/login" method="POST" class="space-y-4">
                        <input type="hidden" name="role" value="student">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                                ENROLLMENT NUMBER <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <i class="fas fa-id-card absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></i>
                                <input type="text" id="student-enrollment" name="enrollmentNo" value="<%= typeof enteredEnrollment !== 'undefined' ? enteredEnrollment : '' %>" placeholder="e.g. DE24XXXXX, DS24XXXXX, MB24XXXXX" class="portal-input uppercase tracking-wider" required autofocus>
                            </div>
                            <p class="text-xs text-slate-400 mt-1.5">Enter your registered SDSF Enrollment / Roll Number.</p>
                        </div>

                        <div>
                            <div class="flex flex-wrap items-center justify-between gap-1 mb-1.5">
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                                    PASSWORD <span class="text-red-500">*</span>
                                </label>
                                <button type="button" onclick="openResetPasswordModal()" class="text-xs text-blue-600 hover:text-blue-800 font-semibold hover:underline cursor-pointer">
                                    Forgot / Set Password?
                                </button>
                            </div>
                            <div class="relative">
                                <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></i>
                                <input type="password" id="student-pass" name="password" placeholder="Enter your password (Default: SDSF@1)" class="portal-input" style="padding-right: 44px !important;" required>
                                <i class="fas fa-eye absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base cursor-pointer hover:text-slate-600 z-10" onclick="togglePass('student-pass', this)"></i>
                            </div>
                            <div class="flex items-center justify-between text-[11px] text-slate-500 mt-1.5">
                                <span><i class="fas fa-info-circle text-blue-500 mr-1"></i> Default first-time login password: <strong class="text-slate-700 font-mono">SDSF@1</strong></span>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-md transition flex items-center justify-center gap-2 shadow-sm text-sm cursor-pointer">
                                <i class="fas fa-sign-in-alt"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Teacher Login Form -->
                <div id="form-teacher" class="portal-form-box max-w-md mx-auto hidden">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-slate-800 font-heading">Faculty Portal Login</h3>
                        <p class="text-slate-500 text-xs sm:text-sm mt-1">Manage student internship reviews, evaluations & approvals</p>
                        <p class="text-blue-600 text-xs sm:text-sm font-semibold mt-1">For Teacher's and Official Staffs</p>
                    </div>

                    <form action="/login" method="POST" class="space-y-4">
                        <input type="hidden" name="role" value="teacher">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">FACULTY ID</label>
                            <div class="relative">
                                <i class="fas fa-user-tie absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></i>
                                <input type="text" name="teacherId" placeholder="Enter Faculty ID or Email" class="portal-input portal-teacher-input">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">PASSWORD</label>
                            <div class="relative">
                                <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></i>
                                <input type="password" id="teacher-pass" name="password" placeholder="Enter your password" class="portal-input portal-teacher-input" style="padding-right: 44px !important;">
                                <i class="fas fa-eye absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base cursor-pointer hover:text-slate-600 z-10" onclick="togglePass('teacher-pass', this)"></i>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2.5 px-4 rounded-md transition flex items-center justify-center gap-2 shadow-sm text-sm cursor-pointer">
                                <i class="fas fa-chalkboard-teacher"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Help Desk Section -->
                <div id="section-help" class="portal-form-box max-w-md mx-auto hidden">
                    <div class="text-center mb-5">
                        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 mb-2.5 border border-indigo-100 shadow-sm">
                            <i class="fas fa-headset text-xl"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800 font-heading">Student Help Desk</h3>
                        <p class="text-slate-500 text-xs sm:text-sm mt-0.5">Support &amp; Technical Assistance for SDSF Internship Portal</p>
                    </div>

                    <!-- Notice / Prompt Box -->
                    <div class="bg-amber-50/90 border border-amber-200 border-l-4 border-l-amber-500 rounded-lg p-3.5 mb-5 text-slate-700 text-xs leading-relaxed shadow-sm">
                        <div class="flex items-start gap-2.5">
                            <i class="fas fa-info-circle text-amber-600 text-base mt-0.5 shrink-0"></i>
                            <div>
                                <p class="text-slate-800 leading-normal">
                                    In case students facing any issue and trouble submitting their forms or NOC applications , they are kindly requested to mail or contact the details below.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Contact the Portal Developer Card -->
                    <div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm space-y-3.5">
                        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
                            <div class="w-11 h-11 rounded-full bg-[#16223e] flex items-center justify-center text-[#f2b300] font-bold text-lg shadow-sm shrink-0">
                                <i class="fas fa-laptop-code"></i>
                            </div>
                            <div>
                                <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold block">Contact the Portal Developer</span>
                                <h4 class="text-base font-bold text-slate-800 font-heading">Joyobrata Das</h4>
                            </div>
                        </div>

                        <!-- Email Detail -->
                        <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200/70 hover:border-blue-200 transition">
                            <div class="flex items-center gap-3 overflow-hidden">
                                <div class="w-8 h-8 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-envelope text-sm"></i>
                                </div>
                                <div class="truncate">
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Gmail Id</span>
                                    <a href="mailto:joyobratadas.85912@gmail.com?subject=SDSF%20Internship%20Portal%20Issue" class="text-xs sm:text-sm font-semibold text-blue-600 hover:underline truncate block">
                                        joyobratadas.85912@gmail.com
                                    </a>
                                </div>
                            </div>
                            <a href="mailto:joyobratadas.85912@gmail.com?subject=SDSF%20Internship%20Portal%20Issue" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-md shadow-sm transition shrink-0 flex items-center gap-1.5 ml-2">
                                <i class="fas fa-paper-plane text-[10px]"></i> <span>Mail</span>
                            </a>
                        </div>

                        <!-- Contact No Detail -->
                        <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-200/70 hover:border-emerald-200 transition">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                    <i class="fas fa-phone-alt text-sm"></i>
                                </div>
                                <div>
                                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Contact No</span>
                                    <a href="tel:+918910366038" class="text-xs sm:text-sm font-semibold text-emerald-700 hover:underline block font-mono">
                                        +91 8910366038
                                    </a>
                                </div>
                            </div>
                            <a href="tel:+918910366038" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-md shadow-sm transition shrink-0 flex items-center gap-1.5 ml-2">
                                <i class="fas fa-phone text-[10px]"></i> <span>Call</span>
                            </a>
                        </div>
                    </div>

                    <!-- Back to Login Navigation -->
                    <div class="pt-4 text-center">
                        <button type="button" onclick="switchTab('student')" class="text-xs text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center gap-1.5 cursor-pointer">
                            <i class="fas fa-arrow-left"></i> Back to Student Login
                        </button>
                    </div>
                </div>

                <!-- Guidelines & Downloads Section -->
                <div class="mt-8 pt-6 border-t-2 border-dashed border-slate-200">
                    <div class="text-center mb-6">
                        <span class="inline-block bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-1.5">
                            <i class="fas fa-file-signature mr-1.5"></i> OFFICIAL GUIDELINES
                        </span>
                        <h3 class="text-xl sm:text-2xl font-bold text-[#162b57] font-heading mb-0.5">On-Campus & Off-Campus Internship Documents</h3>
                        <p class="text-blue-600 text-xs sm:text-sm font-semibold mt-1">For Students in other semesters ( 1st - 9th Sem )</p>
                    </div>

                    <!-- Callout Box -->
                    <div class="bg-blue-50/90 border border-blue-200 border-l-4 border-l-blue-600 rounded-lg p-4 mb-6 flex gap-3 text-slate-700 text-xs leading-relaxed shadow-sm">
                        <i class="fas fa-info-circle text-blue-600 text-xl mt-0.5 shrink-0"></i>
                        <div>
                            <h4 class="font-bold text-blue-900 text-sm mb-1 font-heading">Procedure for Internship Authorization</h4>
                            <p>Students who are interested to pursue either <strong>On-Campus</strong> or <strong>Off-Campus</strong> internships are required to download the official <strong>No Objection Certificate (NOC)</strong> and <strong>Internship Permission Letter</strong> templates provided below. You must officially obtain the signature and seal from the <strong>Head of Department (HOD)</strong> to secure permission before starting your internship.</p>
                        </div>
                    </div>

                    <!-- Documents Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Card 1: NOC -->
                        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition duration-200 flex flex-col justify-between">
                            <div>
                                <i class="fas fa-file-pdf text-red-600 text-3xl mb-3"></i>
                                <h4 class="font-bold text-slate-800 text-base mb-1 font-heading">No Objection Certificate (NOC)</h4>
                                <p class="text-slate-500 text-xs mb-4 leading-relaxed">Official NOC document template with blank fields for Name, Enrollment No, & Internship Destination.</p>
                            </div>
                            <div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mb-3 pt-2 border-t border-slate-100">
                                    <span><i class="fas fa-check-circle text-emerald-600"></i> PDF Format</span>
                                    <span><i class="fas fa-stamp text-amber-600"></i> Requires HOD Sign</span>
                                </div>
                                <a href="/docs/SDSF_NOC_Format.pdf" download="SDSF_NOC_Format.pdf" class="w-full bg-[#162b57] hover:bg-[#0d1b38] text-white py-2 px-4 rounded-md text-xs font-bold flex items-center justify-center gap-2 transition shadow-sm">
                                    <i class="fas fa-download"></i> Download NOC (PDF)
                                </a>
                            </div>
                        </div>

                        <!-- Card 2: Permission Letter -->
                        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition duration-200 flex flex-col justify-between">
                            <div>
                                <i class="fas fa-file-contract text-red-600 text-3xl mb-3"></i>
                                <h4 class="font-bold text-slate-800 text-base mb-1 font-heading">Internship Permission & Offer Letter</h4>
                                <p class="text-slate-500 text-xs mb-4 leading-relaxed">Application letter format to request formal departmental permission for your internship placement.</p>
                            </div>
                            <div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mb-3 pt-2 border-t border-slate-100">
                                    <span><i class="fas fa-check-circle text-emerald-600"></i> PDF Format</span>
                                    <span><i class="fas fa-stamp text-amber-600"></i> Requires HOD Sign</span>
                                </div>
                                <a href="/docs/SDSF_Internship_Permission_Letter.pdf" download="SDSF_Internship_Permission_Letter.pdf" class="w-full bg-sky-600 hover:bg-sky-700 text-white py-2 px-4 rounded-md text-xs font-bold flex items-center justify-center gap-2 transition shadow-sm">
                                    <i class="fas fa-download"></i> Download Permission Letter (PDF)
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Student Password Reset / OTP Verification Modal -->
    <div id="modalResetPassword" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden transition-all transform scale-100 my-auto max-h-[95vh] flex flex-col">
            <!-- Modal Header -->
            <div class="bg-[#16223e] text-white px-4 py-3 sm:px-5 sm:py-4 border-b-4 border-[#f2b300] flex items-center justify-between shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-[#f2b300]/20 flex items-center justify-center text-[#f2b300]">
                        <i class="fas fa-key text-sm"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-sm sm:text-base font-heading tracking-wide">Student Password Reset</h4>
                        <p class="text-[10px] sm:text-[11px] text-slate-300">Verify via registered email OTP</p>
                    </div>
                </div>
                <button type="button" onclick="closeResetPasswordModal()" class="text-slate-400 hover:text-white transition text-lg cursor-pointer p-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-4 sm:p-6 overflow-y-auto">
                <!-- Alert box for feedback -->
                <div id="resetModalAlert" class="hidden mb-4 p-3 rounded-lg text-xs items-start gap-2"></div>

                <!-- Step 1: Request OTP -->
                <div id="resetStep1" class="space-y-4">
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Enter your registered <strong>SDSF Enrollment Number</strong>. A 6-digit verification code will be sent to your registered email address to set your new password.
                    </p>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                            ENROLLMENT NUMBER <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fas fa-id-card absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                            <input type="text" id="resetEnrollmentInput" placeholder="e.g. DE24XXXXX, DS24XXXXX" class="portal-input uppercase font-medium">
                        </div>
                    </div>

                    <button type="button" id="btnSendOtp" onclick="handleSendOtp()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-md transition flex items-center justify-center gap-2 shadow-sm text-sm cursor-pointer">
                        <i class="fas fa-paper-plane text-xs"></i> <span>Send Verification Code</span>
                    </button>
                </div>

                <!-- Step 2: Enter OTP & New Password -->
                <div id="resetStep2" class="space-y-4 hidden">
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-xs text-blue-800 flex items-center gap-2">
                        <i class="fas fa-envelope-open-text text-blue-600 text-base shrink-0"></i>
                        <div>
                            <span>OTP sent to: <strong id="resetMaskedEmail" class="font-mono">...</strong></span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                            6-DIGIT VERIFICATION OTP <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fas fa-shield-alt absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                            <input type="text" id="resetOtpInput" maxlength="6" pattern="[0-9]{6}" placeholder="Enter 6-digit OTP" class="portal-input font-mono tracking-widest uppercase">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                            NEW PASSWORD <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                            <input type="password" id="resetNewPass" placeholder="Enter new password (min 6 chars)" class="portal-input" style="padding-right: 44px !important;">
                            <i class="fas fa-eye absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm cursor-pointer hover:text-slate-600 z-10" onclick="togglePass('resetNewPass', this)"></i>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                            CONFIRM NEW PASSWORD <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fas fa-check-double absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                            <input type="password" id="resetConfirmPass" placeholder="Re-enter new password" class="portal-input" style="padding-right: 44px !important;">
                            <i class="fas fa-eye absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm cursor-pointer hover:text-slate-600 z-10" onclick="togglePass('resetConfirmPass', this)"></i>
                        </div>
                    </div>

                    <div class="flex gap-2 pt-1">
                        <button type="button" onclick="backToStep1()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-3 rounded-md transition text-xs cursor-pointer">
                            <i class="fas fa-arrow-left mr-1"></i> Back
                        </button>
                        <button type="button" id="btnSubmitReset" onclick="handleSubmitReset()" class="flex-[2] bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-md transition flex items-center justify-center gap-2 shadow-sm text-xs cursor-pointer">
                            <i class="fas fa-save"></i> <span>Update Password</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

