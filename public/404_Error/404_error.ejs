<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | SDSF Internship Portal</title>
    
    <!-- Google Fonts & Font Awesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#16223e',
                        secondary: '#1f2d52',
                        accent: '#f2b300',
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        montserrat: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-900 via-[#16223e] to-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-amber-400 selection:text-slate-900">

    <!-- Top Header -->
    <header class="w-full border-b border-white/10 bg-[#16223e]/60 backdrop-blur-md px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img src="/photoes/davvLogo.png" alt="DAVV Logo" class="h-10 w-auto object-contain">
                <div class="hidden sm:block">
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">School of Data Science & Forecasting</p>
                    <p class="text-xs text-slate-300">Devi Ahilya Vishwavidyalaya, Indore</p>
                </div>
            </div>
            <a href="/login" class="text-xs font-medium text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-left"></i> Back to Portal
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-12">
        <div class="max-w-lg w-full text-center bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-8 sm:p-10 shadow-2xl shadow-black/40">
            <!-- 404 Visual Icon -->
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-amber-400/10 border border-amber-400/30 text-amber-400 mb-6 shadow-inner">
                <i class="fa-solid fa-compass-drafting text-4xl"></i>
            </div>
            
            <h1 class="text-6xl sm:text-7xl font-extrabold font-['Montserrat'] tracking-tight text-white mb-2">
                404
            </h1>
            <h2 class="text-xl sm:text-2xl font-bold text-amber-400 mb-3">
                Page Not Found
            </h2>
            
            <p class="text-sm text-slate-300 leading-relaxed mb-8">
                The page or resource you are looking for does not exist, has been removed, or is temporarily unavailable.
            </p>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/login" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-semibold text-sm transition-all transform hover:-translate-y-0.5 shadow-lg shadow-amber-400/20">
                    <i class="fa-solid fa-right-to-bracket"></i> Go to Login
                </a>
                <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 border border-white/10 font-medium text-sm transition-all">
                    <i class="fa-solid fa-house"></i> Home
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full text-center py-4 border-t border-white/10 text-xs text-slate-400">
        © School of Data Science and Forecasting, DAVV Indore. All Rights Reserved.
    </footer>

</body>
</html>
