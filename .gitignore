# ==========================================
# Internship Portal - Git Ignore Rules
# ==========================================

# Environment & Secret Files
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json
*.pem
*.key

# Allow example env
!*.env.example
!.env.example

# Vercel & Deployments
.vercel
.vercel/
.output/
.turbo/

# Dependencies
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Data
*.sql
*.sqlite
*.sqlite3
*.db
*.mongodb
uploads/
temp_uploads/

# Logs & Cache
logs/
*.log
*.tmp
*.temp
.cache/
coverage/

# OS & Editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
